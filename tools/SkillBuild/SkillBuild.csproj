<Project Sdk="Microsoft.NET.Sdk">

  <!-- dydo's own authoring tool (Grilling A D9), run with `dotnet run` on this project from the
       repository root. Never referenced by DynaDocs.csproj and never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DynaDocs.SkillBuild</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The reverse reference: the builder reads the CLI's real command tree, so a skill can name only
       a command that exists (DYD-1372). -->
  <ItemGroup>
    <ProjectReference Include="..\..\DynaDocs.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- dydo's own authoring tool (Grilling A D9), run with `dotnet run` on this project from the
       repository root. Never referenced by DynaDocs.csproj and never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DynaDocs.SkillBuild</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>

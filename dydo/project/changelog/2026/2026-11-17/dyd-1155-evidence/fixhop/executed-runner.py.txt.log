import datetime
import hashlib
import json
import os
from pathlib import Path
import platform
import subprocess
import sys
import time

ROOT = Path('/home/balazs/.t3/worktrees/DynaDocs/t3-75b8347d-e921d7fad379d7b7')
OUT = ROOT / 'dydo/project/changelog/2026/2026-11-17/dyd-1155-evidence/fixhop'
name, *command = sys.argv[1:]
def git(*args):
    return subprocess.check_output(['git', *args], cwd=ROOT, text=True).strip()
receipt = {
    'name': name, 'cwd': str(ROOT), 'command': command,
    'merge': git('rev-parse', 'HEAD'),
    'pr_head': 'c1d13d22c6a6c6e9c3ad85a3f0b0de3059fcc3dc',
    'feature_tip': 'b995a1927c9ad29a78f35fc9ee1d5f82ee3b358c',
    'index_listing_sha256': hashlib.sha256(git('ls-files', '--stage').encode()).hexdigest(), 'status': git('status', '--short'),
    'started_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
    'environment': {'platform': platform.platform(), 'python': sys.version,
                    'cgroup': Path('/proc/self/cgroup').read_text(),
                    'dotnet': {k: os.environ.get(k) for k in ['MSBUILDDISABLENODEREUSE', 'DOTNET_CLI_USE_MSBUILD_SERVER', 'UseSharedCompilation']}},
    'signature': 'docs-writer/model: gpt-6.1-sol, high',
    'source_sha256': {str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest()
                      for p in [ROOT / 'dydo/project/changelog/2026/2026-11-17/dyd-1155-scaffold-pickup.md',
                                *sorted((OUT.parent).glob('*.py.txt')), OUT.parent / 'proof.sh',
                                ROOT / 'Scaffold/dydo/reference/linear-workspace-standard.md',
                                ROOT / 'dydo/reference/linear-workspace-standard.md']},
}
start = time.monotonic()
with (OUT / (name + '.log')).open('wb') as log:
    result = subprocess.run(command, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT)
receipt.update(exit=result.returncode, elapsed_seconds=round(time.monotonic() - start, 3),
               finished_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(), log=name + '.log')
(OUT / (name + '.json')).write_text(json.dumps(receipt, indent=2) + '\n')
print(json.dumps({'name': name, 'exit': result.returncode, 'seconds': receipt['elapsed_seconds'], 'log': str(OUT / (name + '.log'))}))
print('\n'.join((OUT / (name + '.log')).read_text(errors='replace').splitlines()[-18:]))
sys.exit(result.returncode)

import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

root = Path('/home/balazs/.t3/worktrees/DynaDocs/t3-75b8347d-e921d7fad379d7b7')
old = '/home/balazs/.t3/worktrees/DynaDocs/t3-a829c0a8-36dac2b1bcc02af9'
evidence = root / 'dydo/project/changelog/2026/2026-11-17/dyd-1155-evidence'
out = evidence / 'fixhop'
feature = 'b995a1927c9ad29a78f35fc9ee1d5f82ee3b358c'
before = [line.split()[0] for line in (out / 'helpers-before.log').read_text().splitlines()]
after = []
for name in ['run', 'passage', 'discovery-count']:
    blob = subprocess.check_output(['git', 'show', 'HEAD:' + str((evidence / (name + '.py')).relative_to(root))], cwd=root)
    current = (evidence / (name + '.py.txt')).read_bytes()
    assert blob == current, name
    after.append(hashlib.sha256(current).hexdigest())
assert before == after
(out / 'helpers-after.log').write_text(''.join(digest + '  ' + str(evidence / (name + '.py.txt')) + '\n' for name, digest in zip(['run', 'passage', 'discovery-count'], after)))
env = dict(os.environ, GIT_INDEX_FILE='/tmp/dyd-1155-feature.index')
subprocess.run(['git', 'read-tree', feature], cwd=root, env=env, check=True)
base = subprocess.check_output(['git', 'ls-files', '*.py'], cwd=root, env=env)
candidate = subprocess.check_output(['git', 'ls-files', '*.py'], cwd=root)
(out / 'python-feature.log').write_bytes(base)
(out / 'python-candidate.log').write_bytes(candidate)
with (out / 'python-inventory-diff.log').open('wb') as log:
    diff = subprocess.run(['diff', '-u', str(out / 'python-feature.log'), str(out / 'python-candidate.log')], stdout=log)
assert diff.returncode == 0
Path('/tmp/dyd-1155-passage.py').write_text((evidence / 'passage.py.txt').read_text().replace(old, str(root)))
shutil.copyfile(evidence / 'discovery-count.py.txt', '/tmp/dyd-1155-discovery-count.py')
proof = (evidence / 'proof.sh').read_text().replace(old, str(root))
copy_line = 'cp ' + str(evidence / 'passage.py.txt') + ' /tmp/dyd-1155-passage.py'
adaptation = "sed -i 's|" + old + '|' + str(root) + "|g' /tmp/dyd-1155-passage.py"
assert copy_line in proof
proof = proof.replace(copy_line, copy_line + '\n' + adaptation)
Path('/tmp/dyd-1155-fixhop-proof.sh').write_text(proof)
(out / 'replay-adaptation.json').write_text(json.dumps({
    'original': str(evidence / 'proof.sh'), 'replayed': '/tmp/dyd-1155-fixhop-proof.sh',
    'old_root': old, 'execution_root': str(root),
    'adaptations': ['Replace old worktree path in /tmp proof copy only',
                    'After copy, replace old root in /tmp/dyd-1155-passage.py only'],
    'old_worktree_accessed': False, 'repository_helpers_byte_unchanged': True,
    'python_inventory_count': len(candidate.splitlines()), 'inventory_diff_exit': diff.returncode,
    'sync_commands': ['git fetch origin', 'git checkout -b dyd-1155-fixhop origin/DYD-1155-scaffold-pickup',
                      'git merge --no-ff origin/feature/dydo-4-0-0'],
    'sync_exits': [0, 0, 0], 'pr_head': 'c1d13d22c6a6c6e9c3ad85a3f0b0de3059fcc3dc',
    'feature_tip': feature,
    'merge': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip(),
    'helpers_sha256': dict(zip(['run', 'passage', 'discovery-count'], after)),
}, indent=2) + '\n')
print('All three helper hashes match before/after; Python inventory equals feature tip:', len(candidate.splitlines()), 'tracked Python files; diff exit', diff.returncode)
print('Toolchain executables:', {name: shutil.which(name) for name in ['dotnet', 'python3.14', 'pnpm', 'node']})
for command in [['dotnet', '--version'], ['python3.14', '--version'], ['node', '--version'], ['pnpm', '--version']]:
    subprocess.run(command, check=True)
print('All replay copies prepared in /tmp; original worktree untouched.')

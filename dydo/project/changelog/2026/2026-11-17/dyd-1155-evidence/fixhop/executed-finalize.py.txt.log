    assert before == (evidence / (name + '.py.txt')).read_bytes()
shutil.copyfile('/tmp/dyd-1155-captain-discovery.log', out / 'proof-replay-discovery.log')
for name in ['runner.py.txt', 'preflight.py.txt', 'static-prerequisites.sh', 'proof.sh', 'finalize.py.txt']:

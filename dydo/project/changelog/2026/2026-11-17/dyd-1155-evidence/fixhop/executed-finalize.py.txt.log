assert not any(path.endswith(('.json', '.log')) for path in changed), 'Historical receipts changed'
for path in ['Scaffold/dydo/reference/linear-workspace-standard.md', 'dydo/reference/linear-workspace-standard.md']:
    assert not git('diff', 'HEAD', '--', path)
for name in ['run', 'passage', 'discovery-count']:

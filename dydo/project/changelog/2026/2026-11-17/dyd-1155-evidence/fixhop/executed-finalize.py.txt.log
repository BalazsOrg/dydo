    shutil.copyfile(source, out / ('executed-' + name + '.log'))
shutil.copyfile('/tmp/dyd-1155-passage.py', out / 'executed-passage.py.log')
results = root / 'DynaDocs.Tests/coverage/results'
result_path = results / 'run-1794965179697-ff2120fd/result.json'
shutil.copyfile(result_path, out / 'python-static-result.json')
shutil.copyfile(results / 'adapters/python-static.json', out / 'python-static-adapter.json')
raw_root = results / 'assurance/run-3685865b75d74cd0b03b953db9a5f290'
raw = {str(path.relative_to(root)): path.read_text() for path in sorted(raw_root.rglob('*')) if path.is_file()}

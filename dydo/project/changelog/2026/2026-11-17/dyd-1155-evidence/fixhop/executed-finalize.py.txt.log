        'b': {'result': 'passed', 'build_exit': 0, 'discovered': 62, 'passed': 62, 'failed': 0, 'skipped': 0},
        'c': {'result': 'passed', 'bytes': 799, 'sha256': '139bc33641c2c740d9204057802ca18b6a52bdd18957be8909793bc5f85f6d7e', 'exit': 0},
        'd': {'result': 'passed', 'exit': 0, 'errors': 0, 'warnings': 0},

import hashlib
import pathlib

root = pathlib.Path('/home/balazs/.t3/worktrees/DynaDocs/t3-75b8347d-e921d7fad379d7b7')
paths = ['Scaffold/dydo/reference/linear-workspace-standard.md', 'dydo/reference/linear-workspace-standard.md']
passages = []
for name in paths:
    body = (root / name).read_bytes()
    start = body.index(b'`Ready to Merge` holds for a lane')
    end = body.index(b'\n\nA `FutureFeature`', start)
    passage = body[start:end]
    passages.append(passage)
    print(name, 'bytes=' + str(len(passage)), 'sha256=' + hashlib.sha256(passage).hexdigest())
assert passages[0] == passages[1], 'pickup passages differ'
print('Pickup passages are byte-identical.')
print(passages[0].decode())

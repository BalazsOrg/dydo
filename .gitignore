bin/
!npm/bin/
obj/
/nupkg/
/packages/
riderModule.iml
/_ReSharper.Caches/

nul
DynaDocs.sln.DotSettings.user

# Host-local files stay local. Canonical skills are authored in /skills; setup-skills.mjs
# creates the ignored host discovery projections without hiding other host configuration.
.claude/*
!.claude/agents/
!.claude/workflows/
!.claude/settings.json
/.claude/skills/
/.agents/skills/

# DynaDocs agent workspaces (local state)
dydo/agents/

dydo/_system/.local/

# Static-gate Python environment, provisioned per checkout from DynaDocs.Tests/coverage/requirements.lock
/.static-gates/

/DynaDocs.Tests/coverage/report
/DynaDocs.Tests/coverage/results
/DynaDocs.Tests/coverage/__pycache__/
/DynaDocs.Tests/coverage/tests/__pycache__/
/DynaDocs.Tests/TestResults

# Map viewer: dependencies and built or generated output
/viewer/node_modules/
/viewer/dist/
/viewer/coverage/
/viewer/test-results/
/viewer/playwright-report/
/viewer/blob-report/
/viewer/e2e/screenshots/
/artifacts/

# Claude Code personal settings (machine-local, wired by 'dydo init claude --join')
.claude/settings.local.json

# Changelog stores human-written Markdown only; gate receipts stay outside Git.
/dydo/project/changelog/**
!/dydo/project/changelog/**/
!/dydo/project/changelog/**/*.md
/dydo/project/changelog/**/artifacts/
/dydo/project/changelog/**/coverage/
/dydo/project/changelog/**/evidence/
/dydo/project/changelog/**/logs/
/dydo/project/changelog/**/receipts/
/dydo/project/changelog/**/testresults/

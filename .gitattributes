# Host artifacts and canonical skills must stay LF on every platform. Claude Code's
# Workflow permission handler rejects CRLF scripts ("control characters that would
# be hidden in the approval dialog").
.claude/workflows/*.js text eol=lf
.claude/agents/*.md text eol=lf
skills/**/*.md text eol=lf
skills/**/agents/openai.yaml text eol=lf
setup-skills.mjs text eol=lf
.codex/agents/*.toml text=auto eol=lf

# The skill builder writes its chart files and why docs with LF, and the golden test compares bytes (K7).
claims/statechart/** text eol=lf
dydo/reference/claims/*.md text eol=lf

# The same for the built role skills and both built standards with their Scaffold copies (K6, K7, K12).
# skills/roles/README.md, hand-written, also matches; it is markdown, already LF under skills/**/*.md above.
skills/roles/**/*.md text eol=lf
skills/roles/**/agents/openai.yaml text eol=lf
dydo/guides/working-tree-standard.md text eol=lf
dydo/reference/linear-workspace-standard.md text eol=lf
Scaffold/dydo/guides/working-tree-standard.md text eol=lf
Scaffold/dydo/reference/linear-workspace-standard.md text eol=lf

# The retained DYD-96 native evidence packet is hashed, not read: its SHA256SUMS
# is authoritative for every other file in that directory, and the assurance
# gate's fixture exclusion (gate_inventory._fixture_exclusion) hashes the bytes
# on disk. Without these rules a fresh checkout applies core.autocrlf and the
# packet materializes as checkout artifacts no manifest entry vouches for.
dydo/agents/workspace/dyd96-portable-wip/native-altcover-evidence/** -text
dydo/agents/workspace/dyd96-portable-wip/native-altcover-evidence/**/*.opencover.xml text eol=crlf

# A byte-exact copy of a real downstream project's config (LC origin/master 8ab5a88b): BOMs and
# LF line endings are the point of the DYD-392 tests, so git must never normalize these bytes.
DynaDocs.Tests/TestData/downstream-lc/** -text
